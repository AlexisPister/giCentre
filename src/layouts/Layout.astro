---
// Markdown pages pass frontmatter under Astro.props.frontmatter; .astro pages pass props directly.
const { title } = Astro.props.frontmatter ?? Astro.props;
const base = import.meta.env.BASE_URL;

// Files in public/ are served at the site root (under base); build their URLs from BASE_URL.
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

const links = [
    { href: `${base}`, label: "Home" },
    { href: `${base}/news`, label: "News" },
    { href: `${base}/projects`, label: "Projects" },
    { href: `${base}/publications`, label: "Publications" },
    { href: `${base}/people`, label: "People" },
];

const strip = (p: string) => p.replace(/\/+$/, "") || "/";
const current = strip(Astro.url.pathname);
const isActive = (href: string) => {
    const target = strip(href);
    return target === strip(base)
        ? current === target
        : current.startsWith(target);
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <link rel="stylesheet" href={asset("global.css")} />
    </head>
    <body>
        <!-- <svg
            class="bg-storyline"
            viewBox={`0 0 ${STORY_W} ${STORY_H}`}
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
        >
            {storyPaths.map((d, i) => <path d={d} stroke={storyColors[i]} />)}
        </svg> -->

        <header></header>

        <main>
            <nav>
                <a href={base} id="logo-link" aria-label="Home">
                    <img
                        id="logo"
                        src={asset("giCentre.png")}
                        alt="giCentre logo"
                    />
                </a>

                <div id="menu">
                    {links.map((link) => (
                        <a
                            href={link.href}
                            class={isActive(link.href) ? "active" : undefined}
                            aria-current={
                                isActive(link.href) ? "page" : undefined
                            }
                        >
                            {link.label}
                        </a>
                    ))}
                </div>
            </nav>

            <slot />

            <footer>
                <ul class="social">
                    <!-- <li>
                        <a
                            href="https://www.linkedin.com/company/gicentre"
                            target="_blank"
                            rel="noopener noreferrer">LinkedIn</a
                        >
                    </li> -->
                    <li>
                        <a
                            href="https://bsky.app/profile/gicentre.bsky.social"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Bluesky
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://diverse-cdt.ac.uk/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Diverse CDT
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://www.citystgeorges.ac.uk/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            City St George's
                        </a>
                    </li>
                </ul>
            </footer>
        </main>
    </body>

    <style>
        .bg-storyline {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            opacity: 0.3;
        }

        .bg-storyline path {
            fill: none;
            stroke-width: 4;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        main {
            position: relative;
            margin: 0 auto;
            width: 100%;
            max-width: 1000px;
            padding: 1rem 1rem;
            font-family: system-ui;
            font-size: 1.1rem;
        }

        nav {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 2rem;
        }

        #menu > a {
            position: relative;
            margin-left: 1rem;
            color: #555;
            text-decoration: none;
            /* reserved so hover/active never shift the text */
            padding-bottom: 0.3rem;
            font-size: 1.4rem;
        }

        /* Underline: a thick, flat coloured bar, very slightly rotated. */
        #menu > a::after {
            content: "";
            position: absolute;
            left: -0.1em;
            right: -0.1em;
            bottom: 0.05em;
            height: 0.28em;
            background-color: #29a19c;
            /* drawn left-to-right on hover */
            clip-path: inset(0 100% 0 0);
            transition: clip-path 0.25s ease-out;
            pointer-events: none;
        }

        /* A tiny alternating tilt. */
        #menu > a:nth-child(odd)::after {
            transform: rotate(-1.5deg);
        }

        #menu > a:nth-child(even)::after {
            transform: rotate(1.2deg);
        }

        #menu > a:hover::after,
        #menu > a.active::after {
            clip-path: inset(0 0 0 0);
        }

        #menu > a.active,
        #menu > a:hover {
            color: #000;
        }

        @media (prefers-reduced-motion: reduce) {
            #menu > a::after {
                transition: none;
            }
        }

        /* block, so the inline descender gap doesn't offset the logo from the
           bottom-aligned menu next to it */
        #logo-link {
            display: block;
            text-decoration: none;
        }

        #logo {
            max-width: 260px;
            height: auto;
        }

        footer {
            margin-top: 3rem;
            padding-top: 1rem;
            border-top: 1px solid #ddd;
            color: #888;
            font-size: 0.9rem;
        }

        .social {
            list-style: none;
            display: flex;
            gap: 1rem;
            margin: 0;
            padding: 0;
        }

        .social a {
            color: #555;
            text-decoration: underline;
            font-weight: normal;
        }

        .social a:hover {
            color: #000;
            text-decoration: underline;
        }
    </style>
</html>
