---
import yaml from "js-yaml";
import MarkdownIt from "markdown-it";
import newsYaml from "../news.yaml?raw";

interface NewsItem {
    title: string;
    date: string;
    imgs?: string[];
    content: string;
}

const items = (yaml.load(newsYaml) ?? []) as NewsItem[];

const md = new MarkdownIt();

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

const formatDate = (date: string) =>
    new Date(date).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
---

<section class="news">
    <h2>News</h2>

    {
        items.map((item) => (
            <article>
                <h3>{item.title}</h3>
                <p class="date">{formatDate(item.date)}</p>
                {(item.imgs ?? []).map((img) => (
                    <img src={asset(img)} alt={item.title} />
                ))}
                <div class="content" set:html={md.render(item.content)} />
            </article>
        ))
    }
</section>

<style>
    .news article {
        margin-bottom: 2.5rem;
    }

    .news .date {
        color: #888;
        font-size: 0.9rem;
        margin: 0 0 1rem;
    }
</style>
