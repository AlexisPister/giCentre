---
import yaml from "js-yaml";
import MarkdownIt from "markdown-it";
import newsYaml from "../news.yaml?raw";

interface NewsItem {
    title: string;
    date: string;
    imgs?: string[];
    preview?: string;
    content: string;
}

interface Props {
    // Show only the most recent `limit` items; omit to show them all.
    limit?: number;
    // Add a link through to the full news page.
    moreLink?: boolean;
    // Show images as small thumbnails beside the text rather than full width.
    thumbnails?: boolean;
    // Show each item's short `preview` line instead of its full content.
    preview?: boolean;
}

const {
    limit,
    moreLink = false,
    thumbnails = false,
    preview = false,
} = Astro.props;

// Newest first, so the yaml file can stay in whatever order is convenient.
const all = ((yaml.load(newsYaml) ?? []) as NewsItem[]).sort(
    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const items = limit ? all.slice(0, limit) : all;

const md = new MarkdownIt();

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

// Items should carry their own `preview`; fall back to the opening paragraph of
// the body so a missing one degrades to something readable rather than a blank.
const previewText = (item: NewsItem) =>
    item.preview ??
    item.content
        .split(/\n\s*\n/)[0]
        .replace(/\s+/g, " ")
        .trim();

// Stable anchor for each item on the news page, e.g. "2025-12-26-2025-a-standout-year".
const slug = (item: NewsItem) =>
    `${new Date(item.date).toISOString().slice(0, 10)}-${item.title}`
        .toLowerCase()
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 80);

const formatDate = (date: string) =>
    new Date(date).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
---

<section class:list={["news", { thumbnails }]}>
    {
        items.map((item) => {
            const imgs = item.imgs ?? [];
            return (
                <article id={slug(item)}>
                    {thumbnails && imgs.length > 0 && (
                        <div class="thumbs">
                            {imgs.map((img) => (
                                <img src={asset(img)} alt={item.title} />
                            ))}
                        </div>
                    )}
                    <div class="body">
                        <h3>{item.title}</h3>
                        <p class="date">{formatDate(item.date)}</p>
                        {!thumbnails &&
                            imgs.map((img) => (
                                <img src={asset(img)} alt={item.title} />
                            ))}
                        {preview ? (
                            <div class="preview-row">
                                <p
                                    class="preview"
                                    set:html={md.renderInline(previewText(item))}
                                />
                                <a
                                    class="read-more"
                                    href={`${asset("news")}#${slug(item)}`}
                                >
                                    Read more →
                                </a>
                            </div>
                        ) : (
                            <div
                                class="content"
                                set:html={md.render(item.content)}
                            />
                        )}
                    </div>
                </article>
            );
        })
    }

    {
        moreLink && (
            <p class="more">
                <a href={asset("news")}>All news →</a>
            </p>
        )
    }
</section>

<style>
    .news article {
        margin-bottom: 2.5rem;
        /* breathing room when jumped to from a "Read more" link */
        scroll-margin-top: 1rem;
    }

    .news article + article {
        border-top: 1px solid #eee;
        padding-top: 2rem;
    }

    .news h3 {
        margin-bottom: 0.25rem;
        margin-top: 0px;
    }

    .news .date {
        color: #888;
        font-size: 0.9rem;
        margin: 0 0 1rem;
    }

    .news img {
        display: block;
        margin: 0 0 1rem;
        border-radius: 4px;
    }

    /* Thumbnail mode: image column beside the text. */
    .news.thumbnails article {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    /* Without this the text column refuses to shrink below its content. */
    .news .body {
        min-width: 0;
        /* fill the row, so every "Read more" lines up at the right edge */
        flex: 1;
    }

    .news .thumbs {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .news .thumbs img {
        width: 140px;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        margin: 0;
    }

    /* Too narrow for two columns: put the thumbnail back above the text. */
    @media (max-width: 560px) {
        .news.thumbnails article {
            display: block;
        }

        .news .thumbs {
            margin-bottom: 1rem;
        }
    }

    .news .preview {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }

    /* Preview text with a small "Read more" link on the line below, at the right. */
    .news .preview-row {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .news .read-more {
        align-self: flex-end;
        font-size: 0.7rem;
        font-weight: normal;
        color: #aaa;
        text-decoration-color: #ccc;
        text-decoration-thickness: 1px;
        white-space: nowrap;
    }

    .news .read-more:hover {
        color: #555;
        text-decoration-color: #555;
    }

    .news .more {
        margin: 0;
    }
</style>
