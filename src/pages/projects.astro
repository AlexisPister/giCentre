---
import yaml from "js-yaml";
import projectsYaml from "../projects.yaml?raw";
import Layout from "../layouts/Layout.astro";

interface Project {
    name: string;
    image: string;
    description: string;
    link: string;
}

const projects = (yaml.load(projectsYaml) ?? []) as Project[];

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<Layout title="Projects">
    <ul class="project-grid">
        {
            projects.map((project) => (
                <li class="project-card">
                    <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img src={asset(project.image)} alt={project.name} />
                        <h2>{project.name}</h2>
                        <p>{project.description}</p>
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    .project-grid {
        list-style: none;
        padding: 0;
        margin: 2rem 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .project-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        transition:
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }

    .project-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        transform: translateY(-2px);
    }

    .project-card a {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .project-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
    }

    .project-card h2 {
        font-size: 1.1rem;
        margin: 0.75rem 1rem 0.25rem;
        border-bottom: none;
    }

    .project-card p {
        margin: 0 1rem 1rem;
        font-size: 0.9rem;
        color: #555;
    }
</style>
