---
import yaml from "js-yaml";
import projectsYaml from "../projects.yaml?raw";
import Layout from "../layouts/Layout.astro";

interface Project {
    name: string;
    image: string;
    description: string;
    link: string;
    // Optional: names of partner people/organisations on the project.
    collaborators?: string[];
}

const projects = (yaml.load(projectsYaml) ?? []) as Project[];

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<Layout title="Projects">
    <ul class="project-grid">
        {
            projects.map((project) => (
                <li class="project-card">
                    <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img
                            src={`projects/${project.image}`}
                            alt={project.name}
                        />
                        <div class="card-body">
                            <h2>{project.name}</h2>
                            <p>{project.description}</p>
                            {(project.collaborators?.length ?? 0) > 0 && (
                                <p class="collaborators">
                                    <span>Collaborators:</span>{" "}
                                    {project.collaborators?.join(", ")}
                                </p>
                            )}
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    .project-grid {
        list-style: none;
        padding: 0;
        margin: 2rem 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .project-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        transition:
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }

    .project-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        transform: translateY(-2px);
    }

    .project-card a {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    /* Whole card is the link, so don't underline its text on hover. */
    .project-card a:hover {
        text-decoration: none;
    }

    .project-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
    }

    /* Holds the padding and spacing so an optional collaborators line can be
       added without the margins of its neighbours needing to change. */
    .card-body {
        padding: 0.75rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .project-card h2 {
        font-size: 1.1rem;
        margin: 0;
        border-bottom: none;
    }

    .project-card p {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }

    .collaborators {
        font-size: 0.8rem;
        color: #777;
    }

    .collaborators span {
        color: #555;
        font-weight: bold;
    }
</style>
