---
import Layout from "../layouts/Layout.astro";
import publicationsJson from "../publications.json";
import {
    PUBLICATIONS_PORTAL_URL,
    PUBLICATIONS_SEARCH_URL,
    type Publication,
} from "../publications";

// Generated by `npm run publications`; already sorted newest first.
const publications = publicationsJson as Publication[];

// Long consortium papers list dozens of authors; cut them short.
const MAX_AUTHORS = 8;
const authorList = (authors: string[]) =>
    authors.length > MAX_AUTHORS
        ? `${authors.slice(0, MAX_AUTHORS).join(", ")} et al.`
        : authors.join(", ");

const byYear = Map.groupBy(publications, (p) => p.year ?? "Undated");
---

<Layout title="Publications">
    <p>
        Publications by giCentre members, collected from{" "}
        <a href={PUBLICATIONS_PORTAL_URL}>City Research Online</a>.
    </p>

    {[...byYear].map(([year, items]) => (
        <section>
            <h2>{year}</h2>
            <ul class="publications">
                {items.map((p) => (
                    <li>
                        <a href={p.link} class="title">
                            {p.title}
                        </a>
                        <div class="authors">{authorList(p.authors)}</div>
                        {(p.venue || p.doi) && (
                            <div class="meta">
                                {p.venue && <em>{p.venue}</em>}
                                {p.venue && p.doi && " · "}
                                {p.doi && (
                                    <a href={`https://doi.org/${p.doi}`}>
                                        doi:{p.doi}
                                    </a>
                                )}
                            </div>
                        )}
                    </li>
                ))}
            </ul>
        </section>
    ))}
</Layout>

<style>
    .publications {
        list-style: none;
        padding: 0;
        margin: 0 0 2rem;
    }

    .publications li {
        margin-bottom: 1rem;
    }

    .publications .title {
        font-size: 1rem;
    }

    .authors,
    .meta {
        font-size: 0.85rem;
        color: #555;
    }

    .meta a {
        font-weight: normal;
    }
</style>
