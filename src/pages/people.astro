---
import yaml from "js-yaml";
import peopleYaml from "../person.yaml?raw";
import Layout from "../layouts/Layout.astro";

interface Person {
    name: string;
    image?: string;
    bio: string;
    website?: string;
}

interface People {
    academics: Person[];
    phd: Person[];
    alumni: Person[];
}

const people = (yaml.load(peopleYaml) ?? {}) as People;

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<Layout title="People">
    <h2 class="section-title">Academics</h2>
    <ul class="people-list">
        {
            people.academics.map((person) => (
                <li class="person">
                    {person.image ? (
                        <img
                            class="person-photo"
                            src={asset(person.image)}
                            alt={person.name}
                        />
                    ) : (
                        <span class="person-photo person-photo--empty" />
                    )}
                    <div class="person-info">
                        <h3>
                            {person.website ? (
                                <a
                                    href={person.website}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {person.name}
                                </a>
                            ) : (
                                person.name
                            )}
                        </h3>
                        <p>{person.bio}</p>
                    </div>
                </li>
            ))
        }
    </ul>

    <h2 class="section-title">PhD Students</h2>
    <ul class="people-list">
        {
            people.phd.map((person) => (
                <li class="person">
                    {person.image ? (
                        <img
                            class="person-photo"
                            src={asset(person.image)}
                            alt={person.name}
                        />
                    ) : (
                        <span class="person-photo person-photo--empty" />
                    )}
                    <div class="person-info">
                        <h3>
                            {person.website ? (
                                <a
                                    href={person.website}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {person.name}
                                </a>
                            ) : (
                                person.name
                            )}
                        </h3>
                        <p>{person.bio}</p>
                    </div>
                </li>
            ))
        }
    </ul>

    <h2 class="section-title">Alumni</h2>
    <ul class="alumni-list">
        {
            people.alumni.map((person) => (
                <li class="alumni">
                    <h3>
                        {person.website ? (
                            <a
                                href={person.website}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {person.name}
                            </a>
                        ) : (
                            person.name
                        )}
                    </h3>
                    <p>{person.bio}</p>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    .section-title {
        margin-top: 2.5rem;
    }

    .people-list,
    .alumni-list {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .person {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .person-photo {
        width: 150px;
        height: 190px;
        flex-shrink: 0;
        object-fit: cover;
        object-position: center top;
        border-radius: 8px;
        background: #f0f0f0;
    }

    .person-photo--empty {
        display: inline-block;
    }

    .person-info h3,
    .alumni h3 {
        font-family: system-ui, sans-serif;
        font-size: 1.1rem;
        margin: 0 0 0.35rem;
    }

    .person-info a,
    .alumni a {
        color: inherit;
        text-decoration: none;
    }

    .person-info a:hover,
    .alumni a:hover {
        text-decoration: underline;
    }

    .person-info p,
    .alumni p {
        margin: 0;
        font-size: 0.95rem;
        color: #555;
        white-space: pre-line;
    }
</style>
