---
import yaml from "js-yaml";
import peopleYaml from "../person.yaml?raw";
import Layout from "../layouts/Layout.astro";

interface Person {
    name: string;
    image: string;
    bio: string;
    website?: string;
}

const people = (yaml.load(peopleYaml) ?? []) as Person[];

const base = import.meta.env.BASE_URL;
const asset = (path: string) =>
    `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---

<Layout title="People">
    <h1>People</h1>

    <ul class="people-list">
        {
            people.map((person) => (
                <li class="person">
                    {person.image ? (
                        <img
                            class="person-photo"
                            src={asset(person.image)}
                            alt={person.name}
                        />
                    ) : (
                        <span class="person-photo person-photo--empty" />
                    )}
                    <div class="person-info">
                        <h2>
                            {person.website ? (
                                <a
                                    href={person.website}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {person.name}
                                </a>
                            ) : (
                                person.name
                            )}
                        </h2>
                        <p>{person.bio}</p>
                    </div>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    .people-list {
        list-style: none;
        padding: 0;
        margin: 2rem 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .person {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .person-photo {
        width: 150px;
        height: 190px;
        flex-shrink: 0;
        object-fit: cover;
        object-position: center top;
        border-radius: 8px;
        background: #f0f0f0;
    }

    .person-photo--empty {
        display: inline-block;
    }

    .person-info h2 {
        font-size: 1.1rem;
        margin: 0 0 0.35rem;
        border-bottom: none;
    }

    .person-info a {
        color: inherit;
        text-decoration: none;
    }

    .person-info a:hover {
        text-decoration: underline;
    }

    .person-info p {
        margin: 0;
        font-size: 0.95rem;
        color: #555;
        white-space: pre-line;
    }
</style>
